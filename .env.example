# Public ports
APP_PORT=80
PHPMYADMIN_PORT=8090
SIMULATOR_TELEMETRY_PORT=8080
SIMULATOR_COMMAND_PORT=8081
SIMULATOR_DECODER_PORT=8082
SIMULATOR_IMAGES_PORT=8084
ANOMALY_API_PORT=8010
ENHANCEMENT_API_PORT=8011
OBJECT_DETECTION_API_PORT=8012
PANORAMA_API_PORT=8013
SEGMENTATION_API_PORT=8014

# Laravel
APP_NAME=MCCS-Backend
APP_ENV=local
APP_DEBUG=true
# Development-only key. Replace this with a new key for any shared deployment.
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
APP_URL=http://localhost
FRONTEND_URL=http://localhost

# MySQL
DB_DATABASE=mccs
DB_USERNAME=mcc
DB_PASSWORD=mcc_password
DB_ROOT_PASSWORD=change_me_root_password

# Redis / queues
REDIS_PASSWORD=
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Laravel Reverb
REVERB_APP_ID=mcc-local
REVERB_APP_KEY=mcc-local-key
REVERB_APP_SECRET=mcc-local-secret
REVERB_PORT=8080

# AI/ML FastAPI services on the Compose network
ANOMALY_API_URL=http://ml-anomaly:8000
ANOMALY_API_KEY=change-me-in-production
ENHANCEMENT_API_URL=http://ml-enhancement:8000
OBJECT_DETECTION_API_URL=http://ml-object-detection:8000
PANORAMA_API_URL=http://ml-panorama:8000
SEGMENTATION_API_URL=http://ml-segmentation:8000
SATELLITE_API_URL=http://simulator-telemetry:8080
COMMAND_API_URL=ws://simulator-command:8081/ws/radio
DECODER_API_URL=http://simulator-decoder:8082
