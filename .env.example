# Public ports
APP_PORT=80
PHPMYADMIN_PORT=8081

# Laravel
APP_NAME=MCCS-Backend
APP_ENV=local
APP_DEBUG=true
# Development-only key. Replace this with a new key for any shared deployment.
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
APP_URL=http://localhost
FRONTEND_URL=http://localhost

# MySQL
DB_DATABASE=mccs
DB_USERNAME=mcc
DB_PASSWORD=mcc_password
DB_ROOT_PASSWORD=change_me_root_password

# Redis / queues
REDIS_PASSWORD=
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Laravel Reverb
REVERB_APP_ID=mcc-local
REVERB_APP_KEY=mcc-local-key
REVERB_APP_SECRET=mcc-local-secret
REVERB_PORT=8080

# Optional external service URLs used by the Laravel services
ANOMALY_API_URL=
ANOMALY_API_KEY=
ENHANCEMENT_API_URL=
OBJECT_DETECTION_API_URL=
PANORAMA_API_URL=
SATELLITE_API_URL=
COMMAND_API_URL=
DECODER_API_URL=
